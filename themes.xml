<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Theme.Score247 is the theme named in AndroidManifest.xml. It is the splash-screen
        theme: it shows the app icon on `splash_background` while the saved match loads,
        then switches to Theme.Score247.Base. (No windowSplashScreenAnimatedIcon is set,
        so the launcher icon is used automatically.)
    -->
    <style name="Theme.Score247" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Score247.Base</item>
    </style>

    <!--
        Platform theme behind Compose. The app draws edge-to-edge, so the system bars are
        transparent; status/navigation bar ICON colours are set per screen in code
        (see SystemBarIcons in Components.kt). `window_background` has a night variant so
        there is no white flash in dark mode.
    -->
    <style name="Theme.Score247.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
